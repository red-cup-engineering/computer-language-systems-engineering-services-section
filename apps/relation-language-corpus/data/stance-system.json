{
  "kind": "x-rel.stance-system",
  "language": "x-rel",
  "maturity": {
    "chargeParticles": "Built+green",
    "provenanceOblique": "Built+green",
    "lexicalModality": "Built+green",
    "dialogueForce": "Built+green",
    "inflectionalMood": "Roadmap"
  },
  "dimensions": {
    "charge": {
      "carrier": "FOUR",
      "particles": [
        { "surface": "ta", "value": "potential", "stance": "asserted or presently operative" },
        { "surface": "na", "value": "potential", "stance": "possible, pending, or not yet settled" },
        { "surface": "sha", "value": "stable", "stance": "held under contradiction without explosion" },
        { "surface": "mu", "value": "absurd", "stance": "unusable or incoherent information" }
      ]
    },
    "evidentiality": {
      "strategy": "source as oblique participant",
      "particles": [
        { "surface": "pa", "role": "provenance", "relation": "case", "reading": "by witness/source of" }
      ],
      "sourceNouns": [
        { "surface": "sava", "semantic": "witness" },
        { "surface": "luma", "semantic": "uncertainty" },
        { "surface": "davu", "semantic": "doubt" }
      ]
    },
    "modality": {
      "strategy": "lexical modal agency verbs",
      "verbs": [
        { "surface": "kan", "kind": "possibility", "reading": "capability or can" },
        { "surface": "kod", "kind": "necessity", "reading": "obligation or must" },
        { "surface": "nul", "kind": "deontic refusal", "reading": "visible refusal of an obligation or proposed act" },
        { "surface": "dav", "kind": "epistemic doubt", "reading": "doubt or unsettled confidence" }
      ]
    },
    "dialogueForce": {
      "strategy": "clause-initial discourse particles",
      "particles": [
        { "surface": "ku", "force": "question", "reading": "information request" },
        { "surface": "du", "force": "request", "reading": "directive request" },
        { "surface": "se", "force": "answer", "reading": "answer or confirmation" },
        { "surface": "ha", "force": "acknowledgement", "reading": "uptake or acknowledgement" }
      ]
    }
  },
  "examples": [
    {
      "id": "stance-rel-001",
      "dimension": "charge",
      "text": "sha ni ga ren do kelu.",
      "reading": "stable repair of a relation under contradiction",
      "expect": { "nsubj": "ni", "dobj": "kelu", "verb": "ren", "particles": ["sha"] }
    },
    {
      "id": "stance-rel-002",
      "dimension": "evidentiality",
      "text": "sava pa mi ga mor do tilo.",
      "reading": "marking the tile from a witness source",
      "expect": { "nsubj": "mi", "dobj": "tilo", "verb": "mor", "obliques": [{ "head": "mor", "dep": "sava", "case": "pa" }] }
    },
    {
      "id": "stance-rel-003",
      "dimension": "modality",
      "text": "tu ga kan do kano.",
      "reading": "second-person capability",
      "expect": { "nsubj": "tu", "dobj": "kano", "verb": "kan" }
    },
    {
      "id": "stance-rel-004",
      "dimension": "modality",
      "text": "mi ga kod do koda.",
      "reading": "first-person obligation",
      "expect": { "nsubj": "mi", "dobj": "koda", "verb": "kod" }
    },
    {
      "id": "stance-rel-005",
      "dimension": "dialogueForce",
      "text": "ku tu ga kan do kano?",
      "reading": "question about capability",
      "expect": { "nsubj": "tu", "dobj": "kano", "verb": "kan", "discourse": [{ "head": "kan", "dep": "ku" }] }
    },
    {
      "id": "stance-rel-006",
      "dimension": "stanceStack",
      "text": "sava pa na mi ga dav do luma.",
