{
  "name": "@emsenn/communicating-in-relation-conlang",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Communicating in Relation Conlang - a greenfield manifest-first language package for building relation-native conlangs over @emsenn/communicating.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "main": "./src/index.mjs",
  "bin": {
    "communicate": "./src/scripts/communicate.mjs",
    "communicate-serve": "./src/scripts/communicate-serve.mjs"
  },
  "files": [
    "corpus",
    "data",
    "docs",
    "src",
    "exercises",
    "lessons",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": "./src/index.mjs"
    },
    "./manifest": {
      "import": "./src/manifest.mjs"
    },
    "./bundle": {
      "import": "./src/compiled.mjs"
    },
    "./actions": {
      "import": "./src/actions.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/communicating": "workspace:*",
    "@red-cup-engineering/relating": "workspace:*",
    "@red-cup-engineering/computer-language-systems-engineering-services-section": "workspace:*"
  },
  "sideEffects": false
}
