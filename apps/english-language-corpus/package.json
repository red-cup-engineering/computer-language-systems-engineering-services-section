{
  "name": "@red-cup-engineering/communicating-in-english",
  "version": "0.0.0",
  "type": "module",
  "description": "Communicating in English — the English fiber over @red-cup-engineering/communicating: the compiled English bundle, English realization (generate/realizeClause/section), English prose conformance, and the runnable communicate/communicate-serve surface wired to English.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "main": "./src/index.mjs",
  "bin": {
    "communicate": "./src/scripts/communicate.mjs",
    "communicate-serve": "./src/scripts/communicate-serve.mjs"
  },
  "files": [
    "src",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": "./src/index.mjs"
    },
    "./bundle": {
      "import": "./src/compiled.mjs"
    },
    "./actions": {
      "import": "./src/actions.mjs"
    },
    "./package.json": "./package.json",
    "./pragmatics": "./src/pragmatics.mjs"
  },
  "dependencies": {
    "@lenticule-science/english-language-algebra": "workspace:*",
    "@red-cup-engineering/communicating": "workspace:*",
    "@red-cup-engineering/computer-language-systems-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-system-engine": "workspace:*",
    "@red-cup-engineering/eavt-services-section": "workspace:*",
    "@red-cup-engineering/feltos": "workspace:*",
    "@red-cup-engineering/json-services-section": "workspace:*",
    "@red-cup-engineering/relating": "workspace:*"
  },
  "sideEffects": false
}
