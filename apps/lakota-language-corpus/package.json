{
  "name": "@emsenn/communicating-in-lakota",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Communicating in Lakota — the Lakota fiber over @emsenn/communicating: the compiled Lakota bundle and the runnable communicate/communicate-serve surface wired to Lakota.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "examples": "pnpm run build && node examples/current-surfaces.mjs",
    "pretest": "pnpm run build",
    "test": "node --test \"test/*.test.mjs\"",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "main": "./src/index.mjs",
  "bin": {
    "communicate": "./src/scripts/communicate.mjs",
    "communicate-serve": "./src/scripts/communicate-serve.mjs"
  },
  "files": [
    "data",
    "src",
    "examples",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": "./src/index.mjs"
    },
    "./bundle": {
      "import": "./src/compiled.mjs"
    },
    "./compiled": {
      "import": "./src/compiled.mjs"
    },
    "./raw-bundle": {
      "import": "./src/bundle.mjs"
    },
    "./manifest": {
      "import": "./src/manifest.mjs"
    },
    "./actions": {
      "import": "./src/actions.mjs"
    },
    "./corpus": {
      "import": "./src/corpus.mjs"
    },
    "./frames": {
      "import": "./src/frames.mjs"
    },
    "./maturity": {
      "import": "./src/maturity.mjs"
    },
    "./obligations": {
      "import": "./src/obligations.mjs"
    },
    "./orthography": {
      "import": "./src/orthography.mjs"
    },
    "./paradigms": {
      "import": "./src/paradigms.mjs"
    },
    "./particles": {
      "import": "./src/particles.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@red-cup-engineering/communicating": "workspace:*",
    "@red-cup-engineering/computer-language-systems-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-system-engine": "workspace:*",
    "@red-cup-engineering/eavt-services-section": "workspace:*",
    "@red-cup-engineering/feltos": "workspace:*",
    "@red-cup-engineering/json-services-section": "workspace:*",
    "@red-cup-engineering/relating": "workspace:*"
  },
  "sideEffects": false
}
