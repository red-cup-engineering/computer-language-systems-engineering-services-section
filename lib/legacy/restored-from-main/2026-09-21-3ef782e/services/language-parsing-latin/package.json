{
  "name": "@561-group/latin-language-topology",
  "version": "0.0.1",
  "type": "module",
  "description": "latin-language-topology: Latin as a language-topology fiber-algebra bundle; free word order, role by case, and no articles.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/latin-language-topology.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node ../../scripts/package-boundary/copy-dmts-to-dts.mjs dist",
    "test": "pnpm run build && tsc -p tsconfig.test.json && node --test \".tmp/test-dist/**/*.test.mjs\"",
    "audit:boundary": "node ../../scripts/package-boundary/audit-package-boundary.mjs .",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "import": "./dist/bundle.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@561-group/language-topology": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
